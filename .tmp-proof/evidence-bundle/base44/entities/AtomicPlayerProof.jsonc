{
  "name": "AtomicPlayerProof",
  "type": "object",
  "properties": {
    "proof_run_id": {
      "type": "string"
    },
    "logical_player_key": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "total_xp": {
      "type": "integer"
    },
    "reward_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unlock_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    }
  },
  "required": [
    "proof_run_id",
    "logical_player_key",
    "player_id",
    "revision",
    "total_xp",
    "reward_ids",
    "unlock_ids",
    "receipt_id",
    "request_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}