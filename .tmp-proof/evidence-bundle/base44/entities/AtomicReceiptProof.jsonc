{
  "name": "AtomicReceiptProof",
  "type": "object",
  "properties": {
    "proof_run_id": {
      "type": "string"
    },
    "scope_key": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "request_hash": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "resulting_revision": {
      "type": "integer"
    },
    "request_id": {
      "type": "string"
    }
  },
  "required": [
    "proof_run_id",
    "scope_key",
    "player_id",
    "operation",
    "resource_id",
    "idempotency_key",
    "request_hash",
    "outcome",
    "resulting_revision",
    "request_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.player_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}